package-as: SkillUpForever

manual-changelog:
  filename: .release-notes.md
  markup-type: markdown

ignore:
  - AGENTS.md
  - tools
  - types
  - tests
  - docs
  - media/icon.svg
  - media/icon-400.png
  - stylua.toml
  - ruff.toml
  - Locales/phrases.txt
  - Locales/README.md
  - .agents
  - .claude
  - forever-core

required-dependencies:
  - forevercore

# CurseForge relations: the CurseForge slug of every OptionalDeps folder in the root .toc (WFA-28).
optional-dependencies:
  - auctionator
  - tradeskill-master
  - tomtom
  - syndicator
  - shortest-path-forever
  - questiedb
  - questie
  - atlasloot-forever
